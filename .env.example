# Copy this file to .env for local Docker Compose use.
# Never commit real production credentials.
POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Keep enabled for normal use. Disable only during a controlled benchmark,
# or raise the capacity above the benchmark request count.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_WINDOW=1m
