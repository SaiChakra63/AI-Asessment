# Copy this file to .env for local Docker Compose use.
# Never commit real production credentials.
POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Request metadata. Keep the trust flags false unless a trusted proxy or CDN
# strips client-supplied values and creates these headers itself.
TRUST_FORWARDED_HEADERS=false
TRUSTED_PROXY_ADDRESSES=
TRUST_GEO_HEADERS=false
# Generate at least 32 random bytes. Leaving this blank intentionally makes
# application startup fail until a real local secret is configured.
VISITOR_HASH_SALT=

# Keep enabled for normal use. Disable only during a controlled benchmark,
# or raise the capacity above the benchmark request count.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_WINDOW=1m

# Local Grafana login. Replace these values in your uncommitted .env file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password

# Phase 3 API authentication. Generate two different high-entropy values; do
# not reuse the API key as the pepper and do not commit your real .env file.
# Intentionally blank: the service remains fail-closed for management APIs
# until you generate and set two different high-entropy values locally.
API_KEY_PEPPER=
APP_BOOTSTRAP_API_KEY=
APP_API_CLIENT_ID=local-assessment-client
APP_API_CLIENT_DISPLAY_NAME=Local assessment client
APP_API_CLIENT_AUTHORITIES=URL_WRITE,ANALYTICS_READ,OPS_READ
# Keep false for normal restarts. Set true for one controlled restart only when
# intentionally rotating/reactivating this existing bootstrap client.
APP_API_CLIENT_UPDATE_EXISTING=false
